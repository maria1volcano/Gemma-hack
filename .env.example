# Point at local Ollama or a Brev tunnel (e.g. brev port-forward ... -p 11435:11434).
OLLAMA_HOST=http://127.0.0.1:11435
MODEL=gemma4:latest
# Optional: auto-pause after N warn/block events (0 = disabled for demos)
KIDGUARD_AUTO_PAUSE_AFTER=0
# Instant decisions for local demo_sites/*.html (1=fast pitch, 0=always live Gemma)
KIDGUARD_FAST_DEMO=1
